<Page x:Class="CampusPass.Gui.Pages.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:sys="clr-namespace:System;assembly=System.Runtime"
      Title="运行日志">
    <Grid Margin="36,0,36,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="运行日志" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,14">
            <ui:Button x:Name="RefreshButton" Content="刷新" Appearance="Primary"
                       Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,10,0"
                       Click="OnRefreshClick" />
            <ui:Button x:Name="FolderButton" Content="打开日志目录" Appearance="Secondary"
                       Icon="{ui:SymbolIcon Folder24}" Margin="0,0,16,0"
                       Click="OnOpenFolderClick" />
            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0"
                       Style="{StaticResource FieldLabel}" Text="显示行数" />
            <ComboBox x:Name="TailBox" Width="96" VerticalAlignment="Center"
                      SelectionChanged="OnTailChanged">
                <sys:Int32>500</sys:Int32>
                <sys:Int32>800</sys:Int32>
                <sys:Int32>2000</sys:Int32>
            </ComboBox>
        </StackPanel>

        <Border Grid.Row="2" CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1">
            <ListBox x:Name="LogList" Margin="4"
                     BorderThickness="0" Background="Transparent"
                     FontFamily="Consolas" FontSize="12.5"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,1" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="3" x:Name="LogFooter" Style="{StaticResource HintText}" />
    </Grid>
</Page>
