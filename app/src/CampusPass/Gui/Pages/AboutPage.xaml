<Page x:Class="CampusPass.Gui.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="关于">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,0,36,28">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitle}" Text="关于" />

            <ui:Card Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/CampusPass.png"
                           Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CampusPass" FontSize="24" FontWeight="DemiBold" />
                        <TextBlock x:Name="VersionLine" Margin="0,2,0,0" FontSize="12.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="这个程序做什么" />
                    <TextBlock FontSize="13.5" TextWrapping="Wrap" LineHeight="23"
                               Text="校园网认证工具。它在后台替你完成门户登录，让设备一连上网络就能直接上网，不需要每次手动打开浏览器点登录。" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="工作方式" />
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="4" Height="4" VerticalAlignment="Center" Margin="0,9,0,0"
                                 Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap"
                                   Text="静默检查认证状态并按配置向门户提交表单，不打开浏览器，也不弹出命令行窗口。" />
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="4" Height="4" VerticalAlignment="Center" Margin="0,9,0,0"
                                 Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap"
                                   Text="确认联网成功后立即停止轮询，只有网络变化或重新断网才会再次唤醒，所以空闲时几乎不占 CPU 和网络。" />
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="4" Height="4" VerticalAlignment="Center" Margin="0,9,0,0"
                                 Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap"
                                   Text="默认自动识别登录表单；识别不了时可以在“高级设置”里手动指定提交地址和字段名。" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="4" Height="4" VerticalAlignment="Center" Margin="0,9,0,0"
                                 Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap"
                                   Text="地址里的 {local_ip} 会替换成当前网络的 IPv4 地址。" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="数据与隐私" />
                    <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,10"
                               Text="账号和密码使用 Windows 数据保护接口（DPAPI，当前用户范围）加密后只保存在本机，同一台电脑上的其他 Windows 账户无法解密。" />
                    <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,10"
                               Text="程序只向你自己在“基础设置”中填写的校园网门户地址提交登录表单。它不包含遥测、统计或广告代码，也不会自行检查更新或上传任何信息。" />
                    <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="22"
                               Text="配置、凭据和日志都保存在下面的数据目录中，删除该目录即可清除。开机启动项位于注册表 HKCU\Software\Microsoft\Windows\CurrentVersion\Run。" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="第三方组件" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="13" Text=".NET 8（自包含内置运行时）" />
                        <TextBlock Grid.Column="1" FontSize="13" Text="MIT"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="13" Text="WPF-UI 4.3.0（lepo.co）" />
                        <TextBlock Grid.Column="1" FontSize="13" Text="MIT"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="诊断信息" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12.5" Text="版本"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DiagVersion" FontSize="12.5" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12.5" Text="运行时" Margin="0,7,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DiagRuntime" FontSize="12.5" Margin="0,7,0,0" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Grid.Column="0" FontSize="12.5" Text="数据目录" Margin="0,7,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DiagDataPath" FontSize="12.5" Margin="0,7,0,0" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3" Grid.Column="0" FontSize="12.5" Text="日志文件" Margin="0,7,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DiagLogPath" FontSize="12.5" Margin="0,7,0,0" TextWrapping="Wrap" />
                    </Grid>
                    <ui:Button x:Name="CopyButton" Content="复制诊断信息" Appearance="Secondary"
                               Icon="{ui:SymbolIcon Copy24}" HorizontalAlignment="Left"
                               Click="OnCopyDiagnostics" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
