<Page x:Class="CampusPass.Gui.Pages.BasicPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="基础设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,0,36,28">
        <StackPanel MaxWidth="840" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitle}" Text="基础设置" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="填写校园网账号与门户地址，保存后程序会在后台静默完成认证。" />

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="登录凭据" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="账号" />
                            <ui:TextBox x:Name="UsernameBox" PlaceholderText="校园网账号" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="密码" />
                            <ui:PasswordBox x:Name="PasswordBox"
                                            PlaceholderText="留空则沿用已保存的密码"
                                            RevealButtonEnabled="True" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="门户地址" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="登录页地址" />
                    <ui:TextBox x:Name="PortalUrlBox" Margin="0,0,0,14"
                                PlaceholderText="http://…/showLogin.do" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="表单提交地址" />
                    <ui:TextBox x:Name="SubmitUrlBox" PlaceholderText="http://…/login.do" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="地址中可使用 {local_ip}，程序会替换为当前网络的 IPv4 地址。" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="运行方式" />
                    <ui:ToggleSwitch x:Name="AutoDetectSwitch" Margin="0,0,0,6"
                                     OnContent="自动识别登录表单（推荐，适用于移动/联通/电信）"
                                     OffContent="手动配置（在高级设置里填写字段名）" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                               Text="关闭后请在“高级设置”中手动填写提交地址与字段名。" />

                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="DetectButton" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Search24}" Content="识别表单"
                                   Margin="0,0,10,0" Click="OnDetectClick" />
                        <ui:Button x:Name="SaveButton" Appearance="Primary"
                                   Icon="{ui:SymbolIcon DocumentSave24}" Content="保存并启用"
                                   Margin="0,0,10,0" Click="OnSaveClick" />
                        <ui:Button x:Name="TestButton" Appearance="Success"
                                   Icon="{ui:SymbolIcon Play24}" Content="测试登录"
                                   Margin="0,0,10,0" Click="OnTestClick" />
                        <ui:Button x:Name="StopButton" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Stop24}" Content="停止后台"
                                   Click="OnStopClick" />
                        <ui:ProgressRing x:Name="BusyRing" IsIndeterminate="True"
                                         Width="26" Height="26" Margin="14,0,0,0"
                                         VerticalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource HintText}"
                       Text="程序只在网络变化或定时检查时工作，平时处于等待状态。" />
        </StackPanel>
    </ScrollViewer>
</Page>
