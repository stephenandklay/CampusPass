<Page x:Class="CampusPass.Gui.Pages.AdvancedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:sys="clr-namespace:System;assembly=System.Runtime"
      Title="高级设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,0,36,28">
        <StackPanel MaxWidth="840" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitle}" Text="高级设置" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="只有在关闭“自动识别登录表单”时才需要手动核对这些字段。" />

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="登录表单" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="提交方式" />
                            <ComboBox x:Name="MethodBox" SelectedIndex="0">
                                <sys:String>POST</sys:String>
                                <sys:String>GET</sys:String>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="账号字段名" />
                            <ui:TextBox x:Name="UsernameFieldBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="密码字段名" />
                            <ui:TextBox x:Name="PasswordFieldBox" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="附加字段（每行 key=value）" />
                        <ui:TextBox x:Name="ExtraFieldsBox" MinHeight="92"
                                    AcceptsReturn="True" TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="联网检测" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="联网检测地址" />
                            <ui:TextBox x:Name="ConnectivityUrlBox" Margin="0,0,0,14" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="检测成功内容" />
                            <ui:TextBox x:Name="ConnectivityExpectedBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="检查间隔（秒）" />
                            <ui:NumberBox x:Name="IntervalBox" Minimum="20" Maximum="3600"
                                          SmallChange="10" LargeChange="60" MaxDecimalPlaces="0"
                                          SpinButtonPlacementMode="Inline"
                                          ValidationMode="InvalidInputOverwritten" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="仅在未联网时生效；连上后自动停止轮询。" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="登录成功关键字（用 | 分隔）" />
                        <ui:TextBox x:Name="SuccessKeywordsBox" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="DiscoverRedirectSwitch" Margin="0,16,0,0"
                                     OnContent="自动采用网络重定向给出的登录页"
                                     OffContent="始终使用上面填写的登录页地址" />
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal">
                <ui:Button Content="恢复默认" Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,10,0"
                           Click="OnRestoreClick" />
                <ui:Button Content="保存设置" Appearance="Primary"
                           Icon="{ui:SymbolIcon DocumentSave24}" Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
