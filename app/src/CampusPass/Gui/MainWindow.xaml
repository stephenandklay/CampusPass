<ui:FluentWindow x:Class="CampusPass.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:CampusPass.Gui.Pages"
        Title="CampusPass"
        Width="980" Height="680"
        MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Icon="pack://application:,,,/Assets/CampusPass.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="CampusPass" ShowHelp="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/CampusPass.png" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusPill"
                            Padding="10,4" Margin="0,0,6,0" CornerRadius="12"
                            Background="#1A86EFAC">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9"
                                     VerticalAlignment="Center" Fill="#A9B6C6" />
                            <TextBlock x:Name="StatusText" Margin="7,0,0,0"
                                       VerticalAlignment="Center" FontSize="12"
                                       Text="后台未启用" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           OpenPaneLength="176"
                           HeaderVisibility="Collapsed"
                           Navigated="OnPageNavigated">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="基础设置"
                                       Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type pages:BasicPage}"
                                       NavigationCacheMode="Enabled" />
                <ui:NavigationViewItem Content="高级设置"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type pages:AdvancedPage}"
                                       NavigationCacheMode="Enabled" />
                <ui:NavigationViewItem Content="运行日志"
                                       Icon="{ui:SymbolIcon Notepad24}"
                                       TargetPageType="{x:Type pages:LogPage}"
                                       NavigationCacheMode="Enabled" />
                <ui:NavigationViewItem Content="关于"
                                       Icon="{ui:SymbolIcon Info24}"
                                       TargetPageType="{x:Type pages:AboutPage}"
                                       NavigationCacheMode="Enabled" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
